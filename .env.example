# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=gemelo
POSTGRES_USER=gemelo
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql+psycopg://gemelo:cambia-esto@db:5432/gemelo

# --- Puertos expuestos en el equipo (solo desarrollo) ---
PUERTO_DB=5433
PUERTO_API=8000
PUERTO_WEB=4200

# --- Backend ---
SECRET_KEY=genera-uno-con-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:4200

# --- Modelos de lenguaje (cualquier API compatible con OpenAI) ---
# Ejemplos: Mistral (https://api.mistral.ai/v1), Scaleway (https://api.scaleway.ai/v1),
# OpenAI (https://api.openai.com/v1) u Ollama local (http://host.docker.internal:11434/v1)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODELO=mistral-small-latest
EMBEDDINGS_MODELO=mistral-embed
# Debe coincidir con la dimensión de la columna vector de la migración inicial
EMBEDDINGS_DIMENSION=1024

# --- Voz (fase posterior) ---
STT_BASE_URL=
STT_API_KEY=
STT_MODELO=whisper-large-v3

# --- Fuentes de datos ---
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
ESCO_API_URL=https://ec.europa.eu/esco/api
ONET_URL=https://www.onetcenter.org/dl_files/database/db_31_0_text.zip

# Expresión cron de la ingesta nocturna de ofertas (por defecto, 03:00)
INGESTA_CRON=0 3 * * *
