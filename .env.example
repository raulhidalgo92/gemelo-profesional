# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=gemelo
POSTGRES_USER=gemelo
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql+psycopg://gemelo:cambia-esto@db:5432/gemelo

# --- Puertos expuestos en el equipo (solo desarrollo) ---
PUERTO_DB=5433
PUERTO_API=8000
PUERTO_WEB=4200
PUERTO_ADMINER=8090

# --- Backend ---
SECRET_KEY=genera-uno-con-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:4200

# --- Modelos de lenguaje: Google Gemini en Vertex AI (región UE) ---
# Proveedor: "vertex" (por defecto) u "openai" (cualquier API compatible con OpenAI)
LLM_PROVEEDOR=vertex
# Modelo principal (entrevistas, explicaciones) y ligero (extracción de competencias)
LLM_MODELO=gemini-3.8-flash
LLM_MODELO_LIGERO=gemini-3.1-flash-lite
EMBEDDINGS_MODELO=gemini-embedding-001
# Debe coincidir con la dimensión de la columna vector de la migración inicial
EMBEDDINGS_DIMENSION=1024

# Vertex AI: clave JSON de la cuenta de servicio en secretos/vertex.json (no se versiona).
# VERTEX_PROYECTO vacío = se toma del JSON. Ubicaciones europeas: los modelos Gemini se
# sirven en la multirregión «eu» y los de embeddings en europe-west1 (Bélgica).
VERTEX_PROYECTO=
VERTEX_REGION=eu
VERTEX_REGION_EMBEDDINGS=europe-west1

# Solo si LLM_PROVEEDOR=openai
LLM_BASE_URL=
LLM_API_KEY=

# --- Voz (fase posterior; Gemini admite audio como entrada) ---
STT_BASE_URL=
STT_API_KEY=
STT_MODELO=

# --- Fuentes de datos ---
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
ESCO_API_URL=https://ec.europa.eu/esco/api
ONET_URL=https://www.onetcenter.org/dl_files/database/db_31_0_text.zip
ESCO_ONET_URL=https://esco.ec.europa.eu/system/files/2023-08/ONET_%28Occupations%29_0_updated.csv

# Expresión cron de la ingesta nocturna de ofertas (por defecto, 03:00)
INGESTA_CRON=0 3 * * *
